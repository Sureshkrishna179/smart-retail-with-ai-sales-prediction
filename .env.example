# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=retail_sales_db

# Security Configuration
# JWT secret key for session tokens — generate a secure random 32-byte hex key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# LOW-03 WARNING: ROTATE these keys immediately if this file was ever shared externally
JWT_SECRET=your_jwt_secret_key_here_must_be_32_chars
JWT_EXPIRY_HOURS=8

# Separate signing key for the ML model cache (HIGH-01: MUST differ from JWT_SECRET)
#   python -c "import secrets; print(secrets.token_hex(32))"
ML_CACHE_SIGN_KEY=your_ml_cache_sign_key_here_must_be_32_chars

# CORS must match the URL you open in the browser (same host + PORT)
CORS_ORIGINS=http://localhost:8765

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_LOGIN=10

# Server Listening Port (use 8765 if 8080 is taken by Tomcat/IIS)
PORT=8765

# Auth: 1 = require JWT login (RECOMMENDED for production)
#        0 = open local dashboard (dev/demo only — NOT for production)
REQUIRE_AUTH=1

# Debug static path logging
LOG_DEBUG=0

# Testing: set RUN_INTEGRATION_TESTS=1 to run MySQL/API integration tests locally
# RUN_INTEGRATION_TESTS=0

# LOW-03: NEVER include the real .env in a zip or email.
# Share ONLY .env.example (which this file is).
# Add .env to .zipignore and .dockerignore.
